# ---------------------------------------------------------------
# Copy this file to .env and fill in the values.
#
# IF YOU USE DOCKER: only SECRETS belong here (keys, tokens). Non-secret
# settings (LOG_LEVEL, TRANSCRIBE_*, WEB_*) go in `environment:` inside the
# compose file, so they are visible and editable from a management panel.
# Reason: many panels do not show variables that arrive through `env_file:`.
# ---------------------------------------------------------------

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true

# --- Where the WhatsApp session (QR) is stored ---
AUTH_DIR=auth
# --- Where data, logs, media and contacts go ---
DATA_DIR=data

# ---------------------------------------------------------------
# VOICE NOTE TRANSCRIPTION
# backend: none | openai | command
#   none    -> no transcription (voice notes simply are not filtered)  [default]
#   openai  -> OpenAI-compatible API (Groq, OpenRouter, your own endpoint)
#   command -> run a local command (whisper.cpp, faster-whisper, ...)
#
# NB: if you choose "command" or "openai" also fill in the block below,
#     otherwise `npm run check` reports an error.
TRANSCRIBE_BACKEND=none

# --- backend "command" ---
# {input} = path of the downloaded audio file (ogg/opus)
# {wav}   = the same file converted to 16 kHz mono wav
# {language} = TRANSCRIBE_LANGUAGE
# The command must print ONLY the transcript on stdout.
# Examples:
#   whisper.cpp:    C:\whisper\main.exe -m C:\whisper\models\ggml-small.bin -f {wav} -nt -l {language}
#   faster-whisper: python -m faster_whisper.cli {input} --model small --language it
TRANSCRIBE_COMMAND=
# Only needed if your command uses {wav}
TRANSCRIBE_FFMPEG=ffmpeg
TRANSCRIBE_LANGUAGE=

# --- backend "openai" (also used for Groq and other OpenAI-compatible endpoints) ---
# Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_TRANSCRIBE_MODEL=whisper-large-v3-turbo   (or whisper-large-v3)
#   OPENAI_CLASSIFY_MODEL=openai/gpt-oss-120b        (or openai/gpt-oss-20b)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Optional: model used for the `classify` filter in rules
OPENAI_CLASSIFY_MODEL=gpt-4o-mini

# ---------------------------------------------------------------
# WEB PANEL (optional)
# Rule editor plus a test bench: try a rule against a text or a voice note.
# The test always runs as a dry run: it cannot send anything on WhatsApp.
# ---------------------------------------------------------------

# Start the panel. false = off (default)
WEB_ENABLED=false

# Port to listen on
WEB_PORT=8099

# Where to listen:
#   127.0.0.1  this machine only (default, safe)
#   0.0.0.0    reachable on the LAN
# WARNING: with 0.0.0.0 anyone who reaches the port can read AND REWRITE
# your rules. Always set WEB_TOKEN.
WEB_BIND=127.0.0.1

# Access token. If left empty one is generated on first start, saved to
# data/web-token.txt and printed in the logs.
WEB_TOKEN=

# ---------------------------------------------------------------
# ACTIONS
# ---------------------------------------------------------------

# Sending on WhatsApp. OFF by default: with it on, rules that use the
# "reply" action really write into chats, with your number.
# This is the only guarantee of the project you can turn off, and it can only
# be turned off here — never from rules.yaml, because the web panel can rewrite
# the rules and should not be able to start sending.
# Read receipts and presence stay off either way: those are not configurable.
ALLOW_REPLY=false

# Home Assistant
# The token is created in HA under Profile -> Security -> Long-lived access tokens
# `npm run check` verifies URL and token and reports the house name and version.
HA_URL=
HA_TOKEN=
# webhook id for the "ha.webhook" action
HA_WEBHOOK_ID=

# Telegram (notifications and chat mirroring)
# TOKEN from @BotFather. Send /start to your bot once, otherwise it cannot
# message you (a bot cannot write first).
# Used by both "notify.telegram" and "mirror.telegram".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only used for the hint printed by `npm run check`
TELEGRAM_BOT_USERNAME=

# Health alert: a Telegram message when this instance stops doing its job —
# messages arriving that it cannot decrypt, or the connection lost. At most one
# per hour, and it needs the two Telegram settings above. false = never.
HEALTH_NOTIFY=true

# Timeout for network actions (ms)
ACTION_TIMEOUT_MS=15000
